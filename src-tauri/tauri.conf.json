{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "yayda-tauri",
    "version": "0.1.0",
    "identifier": "com.github.callmeqan.yayda-tauri",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "yayda-tauri",
                "width": 480,
                "height": 360
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["appimage", "nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "allowDowngrades": true,
            "nsis": {
                "installMode": "currentUser",
                "compression": "lzma",
                "languages": ["English"]
            },
            "webviewInstallMode": {
                "type": "skip"
            }
        }
    }
}